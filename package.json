{
  "name": "cognistream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "worker": "tsx --watch src/workers/processor.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/processor.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Asynchronous document ingestion and semantic search service.",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/textsplitters": "^1.0.1",
    "@redis/client": "^6.2.1",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "multer": "^2.3.0",
    "openai": "^7.12.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
