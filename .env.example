VITE_API_URL=http://localhost:3000/api/v1
# Model used for RAG answer synthesis (POST /ask). Separate from the
# embedding model, which is hardcoded in src/infrastructure/gemini.ts.
# Verify this name against Google's current model catalog.
GEMINI_GENERATION_MODEL=gemini-3.6-flash

CORS_ORIGIN=http://localhost:5173

# Leave blank to disable auth (local/dev default). Set this to require a
# matching `x-api-key` header on every /api/v1/* request.
API_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
